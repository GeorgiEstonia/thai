# Railway Postgres connection string.
# Railway dashboard -> Postgres service -> Variables -> DATABASE_PUBLIC_URL
DATABASE_URL=postgresql://user:password@host:5432/railway

# The passphrase you type once on the login screen. Any string you'll remember.
APP_PASSPHRASE=

# Random secret used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Needed only for reading vocabulary off a photographed lesson page.
# Everything else works without it.
ANTHROPIC_API_KEY=
